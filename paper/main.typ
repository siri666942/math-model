#table(
  columns: (auto, auto, 1fr, auto, 1fr),
  align: (center+horizon, center+horizon, left+horizon, center+horizon, left+horizon),
  stroke: 0.5pt, inset: 5pt,
  table.header([*算法*], [*编码方式*], [*关键超参数*], [*与本题契合度*], [*简要评注*]),
